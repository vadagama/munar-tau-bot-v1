{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "lint": {
    "include": [
      "functions/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "postgres": "npm:postgres@^3.4.7",
    "exceljs": "npm:exceljs@4.4.0",
    "exceljs/lib/doc/workbook.js": "npm:exceljs@4.4.0/lib/doc/workbook.js",
    "exceljs/lib/doc/enums.js": "npm:exceljs@4.4.0/lib/doc/enums.js"
  },
  "tasks": {
    "check": "deno check functions/",
    "lint": "deno lint functions/",
    "test": "deno test --allow-env functions/"
  }
}
